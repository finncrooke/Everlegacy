# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
# Plaque bundle pricing lives in src/lib/pricing.ts, not env vars — it's
# business logic (the 1/2/3-plaque discount tiers), not deployment config.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudflare R2 (S3-compatible storage for photos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=everlegacy-media
R2_PUBLIC_HOSTNAME=media.everlegacy.co.uk
NEXT_PUBLIC_R2_PUBLIC_HOSTNAME=media.everlegacy.co.uk

# Cloudflare Stream (video)
CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=

# Resend (transactional email — welcome, order confirmation, shipped/delivered).
# Optional: everything works without it, emails are just skipped (logged) if unset.
RESEND_API_KEY=
# Sending domain — use the shared onboarding@resend.dev address until you've
# verified your own domain in Resend, then switch to e.g. "Everlegacy <hello@everlegacy.co.uk>"
EMAIL_FROM="Everlegacy <onboarding@resend.dev>"

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_EMAILS=owner@everlegacy.co.uk
